        <div class="tooltip">
          <i class="fa fa-info-circle" aria-hidden="true"></i>
          <span class="tooltiptext">An additional $150 admin and handling fee applies to reseller transactions</span>
        </div>
      </td>
    </tr>
  </tbody>
</table>

<p class="center"><a href="#tiers" class="cta-btn">Choose a License</a></p>

<script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>

<script type="text/javascript">
window.gaViewItem = false;
let products = {
    // Sandbox Products (for testing)
    'pri_01k4w5h1bxhg3n90afg787qgr6': '[SANDBOX] Ostinato Solo',

    // Main Products
    'pri_01k4vymc5dd6vyhm1wajdd3zrh': 'Ostinato Solo',
    'pri_01k4wwmpm1v9chr4bw7vp14hf0': 'Ostinato Pro',
    'pri_01k4wwpa2pjpqxapsmth4m9etv': 'Ostinato Business',

    // Labbing SKUs
    'pri_01k4wwra3fhkt30p41w4wknn3z': 'Ostinato for GNS3',
    'pri_01k4wwt9tce6q2zxr4zdzz8qg8': 'Ostinato for EVE-NG',
    'pri_01k4wwvkbd2svv5p96dvp1acca': 'Ostinato for CML',
    'pri_01k4wwxnpjpqxbd6df46e421ap': 'Ostinato for Containerlab',

    // Turbo Add-ons
    'pri_01k4wwz9jp0c0trykghw07sc6x': 'Turbo 10G (add-on)',
    'pri_01k4wx4td44jepqebwfdwfwf3w': 'Turbo 100G (add-on)',
    'pri_01k773zf5skqx44geevpm2svad': 'Turbo 400G (add-on)'
};

function paddleEvents(event) {
    // Paddle Billing event structure
    let checkoutData = {
        currency: event.data?.currency_code || "USD",
        value: (event.data?.totals?.subtotal || 0) - (event.data?.totals?.discount || 0),
        coupon: event.data?.discount?.code || event.data?.discount?.id || null,
        items: (event.data?.items || []).map(item => ({
            item_id: item.price_id,
            item_name: item.product?.name || "Unknown",
            price: (item.totals?.subtotal - item.totals?.discount)/item.quantity || 0,
            quantity: item.quantity || 1
        })),
    };

    if (event.name === "checkout.loaded") {
        let dataLayerInfo = {
            event: "begin_checkout",
            ecommerce: checkoutData,
        };
        dataLayer.push(dataLayerInfo);
    } else if (event.name === "checkout.payment.selected") {
        let dataLayerInfo = {
            event: "add_payment_info",
            ecommerce: checkoutData,
        };
        dataLayer.push(dataLayerInfo);
    } else if (event.name === "checkout.completed") {
        // Store customer email for thank you page survey
        const customerEmail = event.data?.customer?.email;
        if (customerEmail) {
            sessionStorage.setItem('purchase_email', customerEmail);
        } else {
            sessionStorage.removeItem('purchase_email');
        }

        // Store personalUseOnly for thank you page
        const personalUse = event.data?.custom_data?.personal_use_only;
        if (personalUse) {
            sessionStorage.setItem('personal_use_only', '1');
        } else {
            sessionStorage.removeItem('personal_use_only');
        }

        // Track purchase event
        checkoutData.transaction_id = event.data?.transaction_id;
        checkoutData.tax = event.data?.totals?.tax || 0;
        let dataLayerInfo = {
            event: "purchase",
            ecommerce: checkoutData,
        };
        dataLayer.push(dataLayerInfo);
    }
}


Paddle.Initialize({
    token: "live_50828ea746fde904a1fe1e34c95",
    eventCallback: paddleEvents,
    checkout: {
        settings: {
            successUrl: "https://ostinato.org/pricing/thanks"
        }
    }
});

// Emit view_item_list using data attributes on buttons/sections
document.addEventListener('DOMContentLoaded', function () {
    try {
        // Elements that represent purchasable items:
        // - Primary buy buttons (have data-price-id)
        // - Any teaser/list elements tagged with data-item-id
        let elements = Array.from(document.querySelectorAll('[data-price-id]'));
        if (!elements.length) return;

        // Group by list id
        const groups = new Map(); // listId -> { name, ids:Set }

        for (const el of elements) {
            const itemId = el?.dataset?.priceId;
            if (!itemId) continue;

            // Prefer button-level attributes; fallback to nearest ancestor
            const parentWithList = el.closest('[data-list-id],[data-list-name]');
            const listId = el.dataset.listId || parentWithList?.dataset?.listId;
            const listName = el.dataset.listName || parentWithList?.dataset?.listName || listId || 'Unknown List';
            if (!listId) continue; // require a list id to emit

            if (!groups.has(listId)) groups.set(listId, { name: listName, ids: new Set() });
            groups.get(listId).ids.add(itemId);
        }

        for (const [listId, { name, ids }] of groups) {
            const items = Array.from(ids).map(id => ({
                item_id: id,
                item_name: products[id] || 'Unknown'
            }));
            if (!items.length) continue;
            dataLayer.push({
                event: 'view_item_list',
                ecommerce: {
                    item_list_id: listId,
                    item_list_name: name,
                    items: items
                }
            });
        }
    } catch (e) {
        // no-op
    }
});

// Emit view_item on dedicated product detail pages when flagged in front matter
document.addEventListener('DOMContentLoaded', function () {
    try {
        if (!window.gaViewItem) return;
        const el = document.querySelector('[data-price-id]');
        const id = el?.dataset?.priceId;
        if (!id) return;
        dataLayer.push({
            event: 'view_item',
            ecommerce: {
                items: [{
                    item_id: id,
                    item_name: products[id] || 'Unknown'
                }]
            }
        });
    } catch (e) {
        // no-op
    }
});

function openCheckout(ev) {
    const target = ev.currentTarget;
    const itemId = target.dataset.priceId;
    const parentWithList = target.closest('[data-list-id],[data-list-name]');
    const listId = target.dataset.listId || parentWithList?.dataset?.listId || null;
    const listName = target.dataset.listName || parentWithList?.dataset?.listName || null;

    let selectItemEvent = {
        event: "select_item",
        ecommerce: {
          ...(listId ? { item_list_id: listId } : {}),
          ...(listName ? { item_list_name: listName } : {}),
          items: [{
              item_id: itemId,
              item_name: products[itemId] || "Unknown",
          }]
        }
    };
    dataLayer.push(selectItemEvent);

    const personalUseOnly = ev.currentTarget.hasAttribute("data-personal-use-only");
    let itemList = [{
        priceId: ev.currentTarget.dataset.priceId,
        quantity: 1
    }];
    Paddle.Checkout.open({
        items: itemList,
        discountId: ev.currentTarget.dataset.discountId ?
                ev.currentTarget.dataset.discountId : null,
        settings: {
            showAddTaxId: !personalUseOnly
        },
        ...(personalUseOnly && {
            customData: {
                personal_use_only: true
            }
        })
    });
}

buyButtons = document.querySelectorAll('button.buy-btn.pdl')
for (let s of buyButtons) {
  s.addEventListener('click', openCheckout, false);
}
</script>


